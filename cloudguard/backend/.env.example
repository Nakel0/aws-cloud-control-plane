# CloudGuard Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=CloudGuard
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# AWS Credentials
# Option 1: Explicit credentials (for development)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Option 2: Assume role (for cross-account access)
# AWS_ASSUME_ROLE_ARN=arn:aws:iam::123456789012:role/CloudGuardRole

# Database (optional - uses in-memory by default)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudguard

# Redis (optional - for background tasks)
# REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-in-production-to-a-random-string

# Scanning Configuration
SCAN_INTERVAL_HOURS=6
MAX_CONCURRENT_SCANS=10

# Cost Thresholds
IDLE_RESOURCE_DAYS=7
LOW_UTILIZATION_THRESHOLD=10.0

# Security Thresholds
PUBLIC_BUCKET_SEVERITY=critical
UNENCRYPTED_RESOURCE_SEVERITY=high
